					phandle = <0x38>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x38>;
					cooling-device = <0x39 0xffffffff 0xffffffff 0x3a 0xffffffff 0xffffffff 0x3b 0xffffffff 0xffffffff 0x3c 0xffffffff 0xffffffff>;
				};
			};
		};

		cpu1-thermal {
			thermal-sensors = <0x37 0x0b>;

			trips {

				cpu-critical {
					temperature = <0x1d4c0>;
					hysteresis = <0x2710>;
					type = "critical";
				};

				cpu-passive {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x3d>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x3d>;
					cooling-device = <0x39 0xffffffff 0xffffffff 0x3a 0xffffffff 0xffffffff 0x3b 0xffffffff 0xffffffff 0x3c 0xffffffff 0xffffffff>;
				};
			};
		};

		cpu2-thermal {
			thermal-sensors = <0x37 0x0c>;

			trips {

				cpu-critical {
					temperature = <0x1d4c0>;
					hysteresis = <0x2710>;
					type = "critical";
				};

				cpu-passive {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x3e>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x3e>;
					cooling-device = <0x39 0xffffffff 0xffffffff 0x3a 0xffffffff 0xffffffff 0x3b 0xffffffff 0xffffffff 0x3c 0xffffffff 0xffffffff>;
				};
			};
		};

		cpu3-thermal {
			thermal-sensors = <0x37 0x0d>;

			trips {

				cpu-critical {
					temperature = <0x1d4c0>;
					hysteresis = <0x2710>;
					type = "critical";
				};

				cpu-passive {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x3f>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x3f>;
					cooling-device = <0x39 0xffffffff 0xffffffff 0x3a 0xffffffff 0xffffffff 0x3b 0xffffffff 0xffffffff 0x3c 0xffffffff 0xffffffff>;
				};
			};
		};

		wcss-phyb-thermal {
			thermal-sensors = <0x37 0x0e>;

			trips {

				wcss_phyb-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		top-glue-thermal {
			thermal-sensors = <0x37 0x0f>;

			trips {

				top_glue-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x04 0xf08 0x01 0x01 0xf08>;
	};

	aliases {
		serial0 = "/soc@0/serial@78b1000";
		led-boot = "/leds/led-0";
		led-failsafe = "/leds/led-0";
		led-running = "/leds/led-1";
		led-upgrade = "/leds/led-2";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyMSM0,115200n8 earlycon=msm_serial,0x078b1000 clk_ignore_unused pd_ignore_unused root=/dev/ram0 rw";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x40>;
		pinctrl-names = "default";

		button-reset {
			label = "reset";
			linux,code = <0x198>;
			gpios = <0x0e 0x0a 0x01>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <0x41>;
		pinctrl-names = "default";

		led-0 {
			function = "status";
			color = <0x01>;
			gpios = <0x0e 0x06 0x00>;
			default-state = "on";
		};

		led-1 {
			function = "status";
			color = <0x02>;
			gpios = <0x0e 0x10 0x00>;
			default-state = "off";
		};

		led-2 {
			function = "status";
			color = <0x03>;
			gpios = <0x0e 0x11 0x00>;
			default-state = "off";
		};
	};

	regulator-3p3 {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-boot-on;
		regulator-always-on;
		regulator-name = "fixed_3p3";
		phandle = <0x1e>;
	};

	regulator-0p925 {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <0xe1d48>;
		regulator-max-microvolt = <0xe1d48>;
		regulator-boot-on;
		regulator-always-on;
		regulator-name = "fixed_0p925";
		phandle = <0x1c>;
	};

	vdd-usb-phy {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-boot-on;
		regulator-always-on;
		regulator-name = "vdd_usb_phy";
		vin-supply = <0x1e>;
		phandle = <0x1d>;
	};

	smp2p-wcss {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x142 0x01>;
		mboxes = <0x05 0x09>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x34>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x33>;
		};
	};
};
