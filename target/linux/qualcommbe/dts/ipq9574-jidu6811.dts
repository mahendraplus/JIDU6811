/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "JioRouter AX6000 JIDU6J11";
	compatible = "jiorouter,ax6000-jidu6j11\0qcom,ipq9574";

	clocks {

		ref-48mhz-clk {
			compatible = "fixed-factor-clock";
			clocks = <0x02>;
			#clock-cells = <0x00>;
			clock-div = <0x01>;
			clock-mult = <0x02>;
			phandle = <0x03>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			phandle = <0x12>;
		};

		xo-board-clk {
			compatible = "fixed-factor-clock";
			clocks = <0x03>;
			#clock-cells = <0x00>;
			clock-div = <0x02>;
			clock-mult = <0x01>;
			phandle = <0x11>;
		};

		xo-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x16e3600>;
			phandle = <0x02>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x00>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			clocks = <0x05 0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x06>;
			cpu-supply = <0x07>;
			#cooling-cells = <0x02>;
			phandle = <0x39>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x01>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			clocks = <0x05 0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x06>;
			cpu-supply = <0x07>;
			#cooling-cells = <0x02>;
			phandle = <0x3a>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x02>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			clocks = <0x05 0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x06>;
			cpu-supply = <0x07>;
			#cooling-cells = <0x02>;
			phandle = <0x3b>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x03>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			clocks = <0x05 0x01>;
			clock-names = "cpu";
			operating-points-v2 = <0x06>;
			cpu-supply = <0x07>;
			#cooling-cells = <0x02>;
			phandle = <0x3c>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x04>;
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-ipq9574\0qcom,scm";
			qcom,dload-mode = <0x08 0x6100>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	opp-table-cpu {
		compatible = "operating-points-v2-kryo-cpu";
		opp-shared;
		nvmem-cells = <0x09>;
		phandle = <0x06>;

		opp-936000000 {
			opp-hz = <0x00 0x37ca3a00>;
			opp-microvolt = <0xb1008>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1104000000 {
			opp-hz = <0x00 0x41cdb400>;
			opp-microvolt = <0xc042c>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0xd2924>;
			opp-supported-hw = <0x0f>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1416000000 {
			opp-hz = <0x00 0x54667200>;
			opp-microvolt = <0xd2924>;
			opp-supported-hw = <0x07>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1488000000 {
			opp-hz = <0x00 0x58b11400>;
			opp-microvolt = <0xe1d48>;
			opp-supported-hw = <0x07>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1800000000 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0xf116c>;
			opp-supported-hw = <0x05>;
			clock-latency-ns = <0x30d40>;
		};

		opp-2208000000 {
			opp-hz = <0x00 0x839b6800>;
			opp-microvolt = <0x103664>;
			opp-supported-hw = <0x01>;
			clock-latency-ns = <0x30d40>;
		};
	};

	pmu {
		compatible = "arm,cortex-a73-pmu";
		interrupts = <0x01 0x07 0xf04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	remoteproc {
		compatible = "qcom,ipq9574-rpm-proc\0qcom,rpm-proc";

		glink-edge {
			compatible = "qcom,glink-rpm";
			interrupts = <0x00 0xa8 0x01>;
			qcom,rpm-msg-ram = <0x0a>;
			mboxes = <0x05 0x00>;

			rpm-requests {
				compatible = "qcom,rpm-ipq9574\0qcom,glink-smd-rpm";
				qcom,glink-channels = "rpm_requests";

				regulators {
					compatible = "qcom,rpm-mp5496-regulators";

					s1 {
						regulator-min-microvolt = <0xb1008>;
						regulator-max-microvolt = <0x106738>;
						phandle = <0x07>;
					};

					l2 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-always-on;
						regulator-boot-on;
					};
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		bootloader@4a100000 {
			reg = <0x00 0x4a100000 0x00 0x400000>;
			no-map;
		};

		sbl@4a500000 {
			reg = <0x00 0x4a500000 0x00 0x100000>;
			no-map;
		};

		tz@4a600000 {
			reg = <0x00 0x4a600000 0x00 0x400000>;
			no-map;
		};

		smem@4aa00000 {
			compatible = "qcom,smem";
			reg = <0x00 0x4aa00000 0x00 0x100000>;
			hwlocks = <0x0b 0x03>;
			no-map;
		};

		wcnss@4ab00000 {
			no-map;
			reg = <0x00 0x4ab00000 0x00 0x2d00000>;
			phandle = <0x35>;
		};
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;

		sram@60000 {
			compatible = "qcom,rpm-msg-ram";
			reg = <0x60000 0x6000>;
			phandle = <0x0a>;
		};

		phy@84000 {
			compatible = "qcom,ipq9574-qmp-gen3x1-pcie-phy";
			reg = <0x84000 0x1000>;
			clocks = <0x0c 0x48 0x0c 0x54 0x0c 0xd2>;
			clock-names = "aux\0cfg_ahb\0pipe";
			assigned-clocks = <0x0c 0x48>;
			assigned-clock-rates = <0x1312d00>;
			resets = <0x0c 0x15 0x0c 0x16>;
			reset-names = "phy\0common";
			#clock-cells = <0x00>;
			clock-output-names = "gcc_pcie0_pipe_clk_src";
			#phy-cells = <0x00>;
			status = "disabled";
			phandle = <0x13>;
		};

		phy@8c000 {
			compatible = "qcom,ipq9574-qmp-gen3x2-pcie-phy";
			reg = <0x8c000 0x2000>;
			clocks = <0x0c 0x4a 0x0c 0x56 0x0c 0xd4>;
			clock-names = "aux\0cfg_ahb\0pipe";
			assigned-clocks = <0x0c 0x4a>;
			assigned-clock-rates = <0x1312d00>;
			resets = <0x0c 0x1d 0x0c 0x1e>;
			reset-names = "phy\0common";
			#clock-cells = <0x00>;
			clock-output-names = "gcc_pcie2_pipe_clk_src";
			#phy-cells = <0x00>;
			status = "disabled";
			phandle = <0x15>;
		};

		rng@e3000 {
			compatible = "qcom,ipq9574-trng\0qcom,trng";
			reg = <0xe3000 0x1000>;
			clocks = <0x0c 0x73>;
			clock-names = "core";
		};

		mdio@90000 {
			compatible = "qcom,ipq9574-mdio\0qcom,ipq4019-mdio";
			reg = <0x90000 0x64>;
			pinctrl-0 = <0x0d>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x0c 0x72>;
			clock-names = "gcc_mdio_ahb_clk";
			status = "okay";
			reset-gpios = <0x0e 0x3c 0x01>;

			ethernet-phy-package@10 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,qca8075-package";
				reg = <0x10>;

				ethernet-phy@10 {
					reg = <0x10>;
					phandle = <0x29>;
				};

				ethernet-phy@11 {
					reg = <0x11>;
					phandle = <0x2b>;
				};

				ethernet-phy@12 {
					reg = <0x12>;
					phandle = <0x2d>;
				};

				ethernet-phy@13 {
					reg = <0x13>;
					phandle = <0x2f>;
				};

				ethernet-phy@14 {
					reg = <0x14>;
					phandle = <0x31>;
				};
			};
		};

		phy@f4000 {
			compatible = "qcom,ipq9574-qmp-gen3x2-pcie-phy";
			reg = <0xf4000 0x2000>;
			clocks = <0x0c 0x4b 0x0c 0x57 0x0c 0xd5>;
			clock-names = "aux\0cfg_ahb\0pipe";
			assigned-clocks = <0x0c 0x4b>;
			assigned-clock-rates = <0x1312d00>;
			resets = <0x0c 0x21 0x0c 0x22>;
			reset-names = "phy\0common";
			#clock-cells = <0x00>;
			clock-output-names = "gcc_pcie3_pipe_clk_src";
			#phy-cells = <0x00>;
			status = "disabled";
			phandle = <0x16>;
		};

		phy@fc000 {
			compatible = "qcom,ipq9574-qmp-gen3x1-pcie-phy";
			reg = <0xfc000 0x1000>;
			clocks = <0x0c 0x49 0x0c 0x55 0x0c 0xd3>;
			clock-names = "aux\0cfg_ahb\0pipe";
			assigned-clocks = <0x0c 0x49>;
			assigned-clock-rates = <0x1312d00>;
			resets = <0x0c 0x19 0x0c 0x1a>;
			reset-names = "phy\0common";
			#clock-cells = <0x00>;
			clock-output-names = "gcc_pcie1_pipe_clk_src";
			#phy-cells = <0x00>;
			status = "okay";
			phandle = <0x14>;
		};

		clock-controller@9b000 {
			compatible = "qcom,ipq9574-cmn-pll";
			reg = <0x9b000 0x800>;
			clocks = <0x03 0x0c 0x77 0x0c 0xbf>;
			clock-names = "ref\0ahb\0sys";
			#clock-cells = <0x01>;
			assigned-clocks = <0x0f 0x00>;
			assigned-clock-rates-u64 = <0x02 0xcb417800>;
			phandle = <0x0f>;
		};

		efuse@a4000 {
			compatible = "qcom,ipq9574-qfprom\0qcom,qfprom";
			reg = <0xa4000 0x5a1>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			cpu-speed-bin@15 {
				reg = <0x15 0x02>;
				bits = <0x07 0x02>;
				phandle = <0x09>;
			};
		};

		dma-controller@704000 {
			compatible = "qcom,bam-v1.7.4\0qcom,bam-v1.7.0";
			reg = <0x704000 0x20000>;
			interrupts = <0x00 0xcf 0x04>;
			#dma-cells = <0x01>;
			qcom,ee = <0x01>;
			qcom,num-ees = <0x04>;
			num-channels = <0x10>;
			qcom,controlled-remotely;
			status = "disabled";
			phandle = <0x10>;
		};

		crypto@73a000 {
			compatible = "qcom,ipq9574-qce\0qcom,ipq4019-qce\0qcom,qce";
			reg = <0x73a000 0x6000>;
			clocks = <0x0c 0xcf 0x0c 0xce 0x0c 0xcd>;
			clock-names = "iface\0bus\0core";
			dmas = <0x10 0x02 0x10 0x03>;
			dma-names = "rx\0tx";
			status = "disabled";
		};

		thermal-sensor@4a9000 {
			compatible = "qcom,ipq9574-tsens\0qcom,ipq8074-tsens";
			reg = <0x4a9000 0x1000 0x4a8000 0x1000>;
			interrupts = <0x00 0xb8 0x04>;
			interrupt-names = "combined";
			#qcom,sensors = <0x10>;
			#thermal-sensor-cells = <0x01>;
			phandle = <0x37>;
		};

		pinctrl@1000000 {
			compatible = "qcom,ipq9574-tlmm";
			reg = <0x1000000 0x300000>;
			interrupts = <0x00 0xd0 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x0e 0x00 0x00 0x41>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x0e>;

			mdio-pins {
				phandle = <0x0d>;

				mdc-state {
					pins = "gpio38";
					function = "mdc";
					drive-strength = <0x08>;
					bias-disable;
				};

				mdio-state {
					pins = "gpio39";
					function = "mdio";
					drive-strength = <0x08>;
					bias-pull-up;
				};
			};

			uart2-state {
				pins = "gpio34\0gpio35";
				function = "blsp2_uart";
				drive-strength = <0x08>;
				bias-disable;
				phandle = <0x17>;
			};

			spi-0-state {
				pins = "gpio11\0gpio12\0gpio13\0gpio14";
				function = "blsp0_spi";
				drive-strength = <0x08>;
				bias-disable;
			};

			gpio-keys-default-state {
				pins = "gpio10";
				function = "gpio";
				drive-strength = <0x08>;
				bias-pull-up;
				phandle = <0x40>;
			};

			gpio-leds-default-state {
				pins = "gpio6\0gpio16\0gpio17";
				function = "gpio";
				drive-strength = <0x08>;
				bias-pull-up;
				phandle = <0x41>;
			};

			qpic-snand-default-state {
				phandle = <0x1a>;

				clock-pins {
					pins = "gpio5";
					function = "qspi_clk";
					drive-strength = <0x08>;
					bias-disable;
				};

				cs-pins {
					pins = "gpio4";
					function = "qspi_cs";
					drive-strength = <0x08>;
					bias-disable;
				};

				data-pins {
					pins = "gpio0\0gpio1\0gpio2\0gpio3";
					function = "qspi_data";
					drive-strength = <0x08>;
					bias-disable;
				};
			};

			pcie-qcn9074-state {
				phandle = <0x23>;

				clkreq-n-pins {
					pins = "gpio25";
					function = "pcie1_clk";
					drive-strength = <0x06>;
					bias-pull-up;
				};

				perst-n-pins {
					pins = "gpio26";
					function = "gpio";
					drive-strength = <0x08>;
					bias-pull-up;
					output-low;
				};

				wake-n-pins {
					pins = "gpio27";
					function = "pcie1_wake";
					drive-strength = <0x06>;
					bias-pull-up;
				};
			};

			usb-supply-pin {
				pins = "gpio64";
				function = "gpio";
				drive-strength = <0x08>;
				bias-pull-up;
				output-high;
				phandle = <0x1f>;
			};
		};

		clock-controller@1800000 {
			compatible = "qcom,ipq9574-gcc";
			reg = <0x1800000 0x80000>;
			clocks = <0x11 0x12 0x00 0x13 0x14 0x15 0x16 0x00>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#interconnect-cells = <0x01>;
			phandle = <0x0c>;
		};

		hwlock@1905000 {
			compatible = "qcom,tcsr-mutex";
			reg = <0x1905000 0x20000>;
			#hwlock-cells = <0x01>;
			phandle = <0x0b>;
		};

		syscon@1937000 {
			compatible = "qcom,tcsr-ipq9574\0syscon";
			reg = <0x1937000 0x21000>;
			phandle = <0x08>;
		};

		pwm@1941010 {
			compatible = "qcom,ipq9574-pwm\0qcom,ipq6018-pwm";
			reg = <0x1941010 0x20>;
			clocks = <0x0c 0xb2>;
			assigned-clocks = <0x0c 0xb2>;
			assigned-clock-rates = <0x5f5e100>;
			#pwm-cells = <0x03>;
			status = "disabled";
		};

		mmc@7804000 {
			compatible = "qcom,ipq9574-sdhci\0qcom,sdhci-msm-v5";
			reg = <0x7804000 0x1000 0x7805000 0x1000 0x7808000 0x2000>;
			reg-names = "hc\0cqhci\0ice";
			interrupts = <0x00 0x7b 0x04 0x00 0x8a 0x04>;
			interrupt-names = "hc_irq\0pwr_irq";
			clocks = <0x0c 0x67 0x0c 0x64 0x11 0x0c 0x66>;
			clock-names = "iface\0core\0xo\0ice";
			non-removable;
			supports-cqe;
			status = "disabled";
		};

		dma-controller@7884000 {
			compatible = "qcom,bam-v1.7.0";
			reg = <0x7884000 0x2b000>;
			interrupts = <0x00 0xee 0x04>;
			clocks = <0x0c 0x71>;
			clock-names = "bam_clk";
			#dma-cells = <0x01>;
			qcom,ee = <0x00>;
			phandle = <0x18>;
		};

		serial@78af000 {
			compatible = "qcom,msm-uartdm-v1.4\0qcom,msm-uartdm";
			reg = <0x78af000 0x200>;
			interrupts = <0x00 0x6b 0x04>;
			clocks = <0x0c 0x29 0x0c 0x71>;
			clock-names = "core\0iface";
			status = "disabled";
		};

		serial@78b0000 {
			compatible = "qcom,msm-uartdm-v1.4\0qcom,msm-uartdm";
			reg = <0x78b0000 0x200>;
			interrupts = <0x00 0x6c 0x04>;
			clocks = <0x0c 0x2a 0x0c 0x71>;
			clock-names = "core\0iface";
			status = "disabled";
		};

		serial@78b1000 {
			compatible = "qcom,msm-uartdm-v1.4\0qcom,msm-uartdm";
			reg = <0x78b1000 0x200>;
			interrupts = <0x00 0x132 0x04>;
			clocks = <0x0c 0x2b 0x0c 0x71>;
			clock-names = "core\0iface";
			status = "okay";
			pinctrl-0 = <0x17>;
			pinctrl-names = "default";
		};

		serial@78b2000 {
			compatible = "qcom,msm-uartdm-v1.4\0qcom,msm-uartdm";
			reg = <0x78b2000 0x200>;
			interrupts = <0x00 0x133 0x04>;
			clocks = <0x0c 0x2c 0x0c 0x71>;
			clock-names = "core\0iface";
			status = "disabled";
		};

		serial@78b3000 {
			compatible = "qcom,msm-uartdm-v1.4\0qcom,msm-uartdm";
			reg = <0x78b3000 0x200>;
			interrupts = <0x00 0x134 0x04>;
			clocks = <0x0c 0x2d 0x0c 0x71>;
			clock-names = "core\0iface";
			status = "disabled";
		};

		serial@78b4000 {
			compatible = "qcom,msm-uartdm-v1.4\0qcom,msm-uartdm";
			reg = <0x78b4000 0x200>;
			interrupts = <0x00 0x135 0x04>;
			clocks = <0x0c 0x2e 0x0c 0x71>;
			clock-names = "core\0iface";
			status = "disabled";
		};

		spi@78b5000 {
			compatible = "qcom,spi-qup-v2.2.1";
			reg = <0x78b5000 0x600>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0x5f 0x04>;
			clocks = <0x0c 0x1e 0x0c 0x71>;
			clock-names = "core\0iface";
			dmas = <0x18 0x0c 0x18 0x0d>;
			dma-names = "tx\0rx";
			status = "disabled";
		};

		i2c@78b6000 {
			compatible = "qcom,i2c-qup-v2.2.1";
			reg = <0x78b6000 0x600>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0x60 0x04>;
