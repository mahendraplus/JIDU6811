/dts-v1/;

#include "ipq9574-jidu6811.dtsi"

/ {
	model = "JioRouter AX6000 JIDU6J11";
	compatible = "jiorouter,ax6000-jidu6j11", "qcom,ipq9574";
};

&wifi0 {
	qcom,ath11k-calibration-variant = "JIDU6811";
};

&wifi1 {
	qcom,ath11k-calibration-variant = "JIDU6811";
};
