#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

PROG="/usr/bin/led_internet_monitor.sh"

start_service()
{
    procd_open_instance
    procd_set_param command "$PROG"

    # Restart the monitor after a crash, with a short initial delay and a
    # bounded retry window so a persistent failure does not busy-loop.
    procd_set_param respawn 5 10 0

    # Keep diagnostic output available through the system logger.
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}

stop_service()
{
    return 0
}
