#!/bin/sh

# Set system hostname and timezone
uci set system.@system[0].hostname="Maxnet"
uci set system.@system[0].zonename="Asia/Kolkata"
uci set system.@system[0].timezone="IST-5:30"
uci commit system

# Enable Dropbear SSH on LAN
uci set dropbear.@dropbear[0].Interface=""
uci commit dropbear

# Extract real hardware calibration data from 0:ART partition
. /lib/functions.sh
art=$(find_mtd_chardev "0:ART")
if [ -n "$art" ]; then
	mkdir -p /lib/firmware/ath11k/IPQ9574/hw1.0
	dd if=$art of=/lib/firmware/ath11k/IPQ9574/hw1.0/cal-ahb-c000000.wifi.bin bs=4096 skip=1 count=32 2>/dev/null
	mkdir -p /lib/firmware/ath11k/QCN9074/hw1.0
	dd if=$art of=/lib/firmware/ath11k/QCN9074/hw1.0/cal-pci-0001:01:00.0.bin bs=4096 skip=76 count=32 2>/dev/null
fi

# Fallback board.bin templates if not present
mkdir -p /lib/firmware/ath11k/IPQ9574/hw1.0
[ ! -e /lib/firmware/ath11k/IPQ9574/hw1.0/board.bin ] && [ -f /lib/firmware/ath11k/IPQ9574/hw1.0/bdwlan.bin ] && ln -sf /lib/firmware/ath11k/IPQ9574/hw1.0/bdwlan.bin /lib/firmware/ath11k/IPQ9574/hw1.0/board.bin

# Enable wireless radios if detected
if uci get wireless.radio0 >/dev/null 2>&1; then
	uci set wireless.radio0.disabled="0"
	uci set wireless.radio0.band="5g"
	uci set wireless.radio0.channel="36"
	uci set wireless.radio0.htmode="HE80"
	uci set wireless.radio0.country="IN"
	if ! uci get wireless.default_radio0 >/dev/null 2>&1; then
		uci add wireless wifi-iface
		uci set wireless.@wifi-iface[-1].device="radio0"
		uci set wireless.@wifi-iface[-1].network="lan"
		uci set wireless.@wifi-iface[-1].mode="ap"
	fi
	uci set wireless.default_radio0.ssid="MaxNet-5G"
	uci set wireless.default_radio0.encryption="none"
	uci delete wireless.default_radio0.key 2>/dev/null
fi

if uci get wireless.radio1 >/dev/null 2>&1; then
	uci set wireless.radio1.disabled="0"
	uci set wireless.radio1.band="2g"
	uci set wireless.radio1.channel="6"
	uci set wireless.radio1.htmode="HT20"
	uci set wireless.radio1.noscan="1"
	uci set wireless.radio1.country="IN"
	if ! uci get wireless.default_radio1 >/dev/null 2>&1; then
		uci add wireless wifi-iface
		uci set wireless.@wifi-iface[-1].device="radio1"
		uci set wireless.@wifi-iface[-1].network="lan"
		uci set wireless.@wifi-iface[-1].mode="ap"
	fi
	uci set wireless.default_radio1.ssid="MaxNet-2.4G"
	uci set wireless.default_radio1.encryption="none"
	uci delete wireless.default_radio1.key 2>/dev/null
fi

# Add USB Tethering interface (wan_usb) for mobile internet
if ! uci get network.wan_usb >/dev/null 2>&1; then
	uci set network.wan_usb=interface
	uci set network.wan_usb.proto="dhcp"
	uci set network.wan_usb.device="usb0"
	uci commit network
	if uci get firewall.@zone[1] >/dev/null 2>&1; then
		uci add_list firewall.@zone[1].network="wan_usb"
		uci commit firewall
	fi
fi

# Enable LED Internet Lifecycle Monitor Service
/etc/init.d/led_internet_monitor enable
/etc/init.d/led_internet_monitor start

uci commit wireless
exit 0
