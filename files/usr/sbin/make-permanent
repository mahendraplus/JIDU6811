#!/bin/sh
echo "========================================="
echo "  MaxNet OpenWrt Permanent NAND Setup   "
echo "========================================="

if [ ! -f /tmp/initramfs.itb ]; then
	echo "[!] /tmp/initramfs.itb not found in RAM."
	echo "    Copy it from your Linux PC:"
	echo "    cat /srv/tftp/initramfs.itb | ssh root@192.168.1.1 'cat > /tmp/initramfs.itb'"
	exit 1
fi

echo "[1/3] Flashing firmware to NAND (ubi partition)..."
mtd write /tmp/initramfs.itb ubi || { echo "[!] Flash failed"; exit 1; }

echo "[2/3] Configuring U-Boot autoboot environment..."
echo '/dev/mtd17 0x0 0x40000 0x20000' > /etc/fw_env.config
fw_setenv bootcmd 'dcache off; icache off; nand read 0x44000000 0x1700000 0x1100000; bootm 0x44000000'
fw_setenv bootargs 'console=ttyMSM0,115200n8 earlycon'
fw_setenv fdt_high ''
fw_setenv initrd_high ''

echo "[3/3] Done! OpenWrt is now permanently installed."
echo "      Rebooting router into standalone mode..."
sync
reboot
